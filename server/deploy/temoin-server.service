# systemd unit for a Témoin server without Docker.
# Settings in /etc/temoin.env (chmod 600), same variables as server/.env.example.
[Unit]
Description=Témoin server (write-only, receives age-encrypted media)
After=network-online.target
Wants=network-online.target
# Keep retrying forever instead of giving up after 5 quick failures.
StartLimitIntervalSec=0

[Service]
User=temoin
Group=temoin
EnvironmentFile=/etc/temoin.env
Environment=SR_DATA_DIR=/var/lib/temoin SR_BIND=127.0.0.1:8080
ExecStart=/usr/local/bin/temoin-server
# Always come back: after a crash, a kill, or a reboot (with `systemctl enable`).
Restart=always
RestartSec=5
# Hardening: the server only needs its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/temoin
CapabilityBoundingSet=
# Built-in HTTPS on port 443 (SR_ACME_DOMAIN) needs this instead:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
