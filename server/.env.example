# Public key from `sr keygen` (run OFFLINE). NEVER put the AGE-SECRET-KEY here.
SR_RECIPIENT=age1...
SR_NAME=Témoin
SR_PUBLIC_URL=https://record.example.org
# Phones join with invitations created in /admin (one key per phone, bannable).
# Protects /admin (stats, pause switch, invitations, devices).
SR_ADMIN_TOKEN=change-me-admin
# SR_ACCEPTING=true
# SR_MAX_OBJECT_BYTES=16777216
# SR_DEVICE_QUOTA_BYTES=21474836480
# SR_MAX_TOTAL_BYTES=10000000000000
# SR_MIN_FREE_BYTES=53687091200
# SR_MAX_VIDEO_HEIGHT=1080
# SR_DEFAULT_VIDEO_HEIGHT=720
# SR_VIDEO_BITRATE_720=2500000
# SR_VIDEO_BITRATE_1080=5000000
# SR_PHOTO_MAX_PIXELS=4000000
# Journal (logs/events-YYYY-MM-DD.jsonl + /admin): request metadata only, never content.
# SR_LOG_IPS=true
# Behind a reverse proxy: take the client IP from X-Real-IP / X-Forwarded-For.
# SR_TRUST_PROXY=true
# Discreet mode: the server reveals nothing (404s) to anyone without an invitation,
# a registered device key or the admin token. /admin shows a neutral login page.
# SR_STEALTH=true
# SR_ADMIN_PATH=/admin
