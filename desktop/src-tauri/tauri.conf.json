{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Témoin Server",
  "version": "0.1.4",
  "identifier": "io.github.temoin-app.server",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Témoin",
        "width": 960,
        "height": 780,
        "minWidth": 680,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "licenseFile": "../../LICENSE",
    "publisher": "Témoin",
    "shortDescription": "Témoin server for your own computer",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "category": "Utility"
  }
}
