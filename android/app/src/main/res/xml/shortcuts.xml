<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press on the launcher icon: start filming immediately. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@drawable/ic_rec"
        android:shortcutShortLabel="@string/tile_record"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="io.github.temoin_app.temoin.QUICK_RECORD"
            android:targetPackage="io.github.temoin_app.temoin"
            android:targetClass="io.github.temoin_app.temoin.ui.MainActivity" />
    </shortcut>
</shortcuts>
